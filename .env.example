# Copy to .env and export these in the server's environment. Never expose them to the browser.
# Claude (optional) – enables Claude composer, assistant and lyric writing
ANTHROPIC_API_KEY=
AIMS_MODEL=claude-opus-5-5
AIMS_EFFORT=medium

# Vocal / audio provider (optional): fishaudio (speech TTS) or http (your singing-synthesis service)
VOCAL_PROVIDER=
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=
VOCAL_PROVIDER_URL=
VOCAL_PROVIDER_TOKEN=
VOCAL_PROVIDER_NAME=

PORT=8787
